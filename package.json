{
  "name": "git-account-manager",
  "productName": "Git账号管家",
  "version": "1.5.0",
  "description": "Manage which Git account each project uses — tokens & SSH keys in one place. 集中管理每个 Git 项目用哪个账号拉取 / 推送。",
  "main": "src/main.js",
  "author": "50kg",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "io.github.50kg.git-account-manager",
    "productName": "Git账号管家",
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "Git-Account-Manager-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Git-Account-Manager-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Git-Account-Manager-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/50kg/git-account-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/50kg/git-account-manager.git"
  },
  "keywords": [
    "git",
    "github",
    "gitee",
    "gitlab",
    "ssh",
    "token",
    "credential",
    "keychain",
    "account-manager",
    "electron",
    "sourcetree"
  ]
}
